<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ApiUrl" value="https://dev.orders.internal" />
    <add key="MaxRetries" value="3" />
    <add key="FeatureFlags.EnableBulkImport" value="false" />
  </appSettings>
  <connectionStrings>
    <add name="OrdersDb" connectionString="Server=devdb;Database=Orders;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
