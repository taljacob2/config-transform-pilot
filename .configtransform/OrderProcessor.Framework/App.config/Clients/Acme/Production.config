<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="ApiUrl" value="https://acme.orders.internal" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="FeatureFlags.EnableBulkImport" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
