<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="SiteTitle" value="Acme Admin Portal" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow xdt:Transform="Insert" users="acme-admin" />
      </authorization>
    </system.web>
  </location>
</configuration>
